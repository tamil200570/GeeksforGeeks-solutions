class Solution {
    public int getSecondLargest(int[] arr) {
        
        int fmax=Integer.MIN_VALUE;
        int smax=Integer.MIN_VALUE;
        for(int num:arr)
        {
            if(fmax<num)
            {
                smax=fmax;
                fmax=num;
            }
            else if(smax<num && num!=fmax)
            {
                smax=num;
            }
        }
        if(smax==Integer.MIN_VALUE)
        {
            return -1;
        }
         return smax;
    }
}
